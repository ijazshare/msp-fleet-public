#!/bin/sh
# msp-stage LABEL -- COMMAND...  (runs as msp-agent, called only by msp-dispatch)
# Writes ONE pending command for the gate. Prints only "staged: LABEL". Never echoes the command.
set -u
refuse() { echo "refused: $1"; exit 2; }
label=${1:-}; shift || true
case $label in SAFE|SENSITIVE|CREDENTIAL|DESTRUCTIVE) ;; *) refuse "label must be SAFE, SENSITIVE, CREDENTIAL or DESTRUCTIVE";; esac
[ "${1:-}" = "--" ] || refuse "expected -- before the command"; shift
cmd=$*
[ -n "$cmd" ] || refuse "empty command"
lc=$(printf '%s' "$cmd" | tr 'A-Z' 'a-z')
while IFS= read -r p; do [ -n "$p" ] && case $lc in *"$(printf '%s' "$p" | tr 'A-Z' 'a-z')"*) refuse "never-list match: $p";; esac; done < /etc/msp/never.list
if [ "$label" != DESTRUCTIVE ]; then
  while IFS= read -r p; do [ -n "$p" ] && case $lc in *"$(printf '%s' "$p" | tr 'A-Z' 'a-z')"*) refuse "deny-list match ($p): needs label DESTRUCTIVE";; esac; done < /etc/msp/deny.list
fi
[ -f /run/msp/recording ] || refuse "no recorded shell is running; open the Exec seat first"
spool=/var/spool/msp/staged
if [ -f "$spool" ]; then
  age=$(( $(date +%s) - $(stat -c %Y "$spool") ))
  [ "$age" -lt 1800 ] && refuse "a command is already pending ($((age/60)) min old); approve or let it expire"
  rm -f "$spool"
fi
tmp=$(mktemp -p /var/spool/msp .stage.XXXXXX) || refuse "cannot write spool"
printf '%s\n%s\n%s\n' "$label" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$cmd" > "$tmp" && mv -f "$tmp" "$spool"
logger -t msp-stage "staged label=$label by=$(cat /run/msp/recording)"
echo "staged: $label"
