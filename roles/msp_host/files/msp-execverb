#!/bin/sh
# msp-execverb OPERATION ARGS: the one root helper the broker key may run via sudo, and only after the broker
# approved a frozen proposal. Validates every argument; runs exactly one argv list, never a shell. This is the
# host-side boundary (defense in depth): registered operations only, allowlisted units and interpreters only.
set -u
refuse() { echo "refused: $1"; exit 2; }
verb=${1:-}; shift || true
excl=$(grep -v '^[[:space:]]*#' /etc/msp/baseline.conf 2>/dev/null | sed -n 's/^[[:space:]]*guests\.exclude[[:space:]]*=[[:space:]]*//p' | tail -n 1)
case $excl in *[!0-9\ ]*) excl=BAD;; esac
vmid() { case ${1:-} in ''|0*|*[!0-9]*) refuse "vmid must be digits";; esac
         [ "$excl" = BAD ] && refuse "guests.exclude unreadable"; for e in $excl; do [ "$e" = "$1" ] && refuse "vmid excluded at this site"; done; }
have() { command -v "$1" >/dev/null 2>&1 || { echo "not available on this host: $1"; exit 0; }; }
case $verb in
  qm)
    action=${1:-}; vmid "${2:-}"
    case $action in start|shutdown|reboot|stop) ;; *) refuse "unknown qm action: $action";; esac
    have qm; exec qm "$action" "$2" ;;
  pct)
    action=${1:-}; vmid "${2:-}"
    case $action in start|shutdown|reboot|stop) ;; *) refuse "unknown pct action: $action";; esac
    have pct; exec pct "$action" "$2" ;;
  zpool)
    action=${1:-}; pool=${2:-}
    [ "$action" = scrub ] || refuse "only zpool scrub is registered"
    case $pool in ''|*[!A-Za-z0-9._:-]*) refuse "pool name";; esac
    have zpool; zpool list "$pool" >/dev/null 2>&1 || refuse "unknown pool: $pool"
    exec zpool scrub "$pool" ;;
  systemctl)
    action=${1:-}; unit=${2:-}
    [ "$action" = restart ] || refuse "only systemctl restart is registered"
    case $unit in ''|*[!A-Za-z0-9@._:-]*) refuse "unit name";; esac
    grep -qxF -- "$unit" /etc/msp/service.allowlist 2>/dev/null || refuse "unit not in the allowlist: $unit"
    exec systemctl restart "$unit" ;;
  run-script)
    interp=${1:-}; tmo=${2:-}
    case $interp in ''|*[!A-Za-z0-9/_.-]*) refuse "interpreter";; esac
    grep -qxF -- "$interp" /etc/msp/interpreter.allowlist 2>/dev/null || refuse "interpreter not in the allowlist: $interp"
    case $tmo in ''|*[!0-9]*) refuse "timeout must be seconds";; esac
    if [ "$tmo" -lt 1 ] || [ "$tmo" -gt 3600 ]; then refuse "timeout out of range"; fi
    tmp=$(mktemp /run/msp-script.XXXXXX) || refuse "cannot stage the script"
    chmod 600 "$tmp"
    if ! cat > "$tmp"; then rm -f "$tmp"; refuse "cannot read the script"; fi
    timeout "$tmo" "$interp" "$tmp"; rc=$?
    rm -f "$tmp"
    exit $rc ;;
  *) refuse "unknown operation: $verb" ;;
esac
