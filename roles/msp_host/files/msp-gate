#!/bin/sh
# msp-gate step|pending  (root, run inside the recorded Exec shell)
# step: read the staged command ONCE, delete it, show it byte for byte, demand a fresh 4-char code,
# run it as an argument list (no shell), print RESULT on a fixed line, journal + receipt.
set -u
spool=/var/spool/msp/staged; rec=/var/spool/msp/receipts
case ${1:-} in
  pending) if [ -f "$spool" ]; then
             a=$(( $(date +%s) - $(date -d "$(sed -n 2p "$spool")" +%s 2>/dev/null || echo 0) ))
             if [ "$a" -gt 1800 ]; then echo "pending: $(sed -n 1p "$spool") staged $(sed -n 2p "$spool") — EXPIRED ($((a/60)) min), step will discard it"
             else echo "pending: $(sed -n 1p "$spool") staged $(sed -n 2p "$spool") ($((a/60)) min ago, expires at 30)"; fi
           else echo "nothing pending"; fi; exit 0;;
  step) ;;
  *) echo "usage: msp-gate step|pending"; exit 1;;
esac
[ -f "$spool" ] || { echo "nothing staged"; exit 1; }
content=$(cat "$spool"); rm -f "$spool"            # read once; nothing can be approved twice
label=$(printf '%s\n' "$content" | sed -n 1p); when=$(printf '%s\n' "$content" | sed -n 2p); cmd=$(printf '%s\n' "$content" | sed -n 3p)
case $label in SAFE|SENSITIVE|CREDENTIAL|DESTRUCTIVE) ;; *) echo "REFUSED: bad label in spool, discarded"; exit 1;; esac
case $when in *[!0-9TZ:-]*|'') echo "REFUSED: bad timestamp in spool, discarded"; exit 1;; esac
age=$(( $(date +%s) - $(date -d "$when" +%s 2>/dev/null || echo 0) ))
[ "$age" -gt 1800 ] && { echo "EXPIRED: staged $((age/60)) min ago, discarded"; logger -t msp-gate "expired label=$label"; exit 1; }
case $cmd in *[!A-Za-z0-9\ ._:@/=,+-]*) echo "REFUSED: staged text contains characters outside the allowed set, discarded"; exit 1;; esac
lc=$(printf '%s' "$cmd" | tr 'A-Z' 'a-z')   # same lists and matching as msp-stage: a hand-planted spool meets them too
while IFS= read -r p; do [ -n "$p" ] && case $lc in *"$(printf '%s' "$p" | tr 'A-Z' 'a-z')"*) echo "REFUSED: never-list match: $p, discarded"; logger -t msp-gate "refused never-list label=$label"; exit 1;; esac; done < /etc/msp/never.list
if [ "$label" != DESTRUCTIVE ]; then
  while IFS= read -r p; do [ -n "$p" ] && case $lc in *"$(printf '%s' "$p" | tr 'A-Z' 'a-z')"*) echo "REFUSED: deny-list match ($p) without DESTRUCTIVE label, discarded"; logger -t msp-gate "refused deny-list label=$label"; exit 1;; esac; done < /etc/msp/deny.list
fi
printf '\n===== STAGED [%s] %s =====\n' "$label" "$when"
printf '>>>%s<<<\n' "$cmd"
printf '===== end of command (%s bytes) =====\n' "$(printf '%s' "$cmd" | wc -c)"
code=$(tr -dc a-z0-9 < /dev/urandom | head -c 4)
printf 'type %s to run, anything else aborts: ' "$code"; read -r ans
[ "$ans" = "$code" ] || { echo "ABORTED"; logger -t msp-gate "aborted label=$label"; exit 1; }
if [ "$label" = DESTRUCTIVE ]; then
  printf 'DESTRUCTIVE: type the target ID exactly as it appears in the command: '; read -r tid
  case $tid in ''|*[!A-Za-z0-9_.:-]*) echo "ABORTED: target ID must be one non-empty word"; logger -t msp-gate "aborted empty target label=$label"; exit 1;; esac
  case " $cmd " in *" $tid "*) ;; *) echo "ABORTED: target mismatch"; logger -t msp-gate "aborted target mismatch label=$label"; exit 1;; esac
fi
approver=$(cat /run/msp/approver 2>/dev/null || echo root)
set -f; set -- $cmd; set +f
"$@"; rc=$?
printf '===== RESULT rc=%s =====\n' "$rc"
now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
logger -t msp-gate "approved label=$label rc=$rc by=$approver cmd=$cmd"
mkdir -p "$rec"; r="$rec/$(date -u +%Y%m%dT%H%M%SZ)-$$.txt"
printf 'when: %s\nlabel: %s\ncommand: %s\nrc: %s\napprover: %s\nrecording: %s\n' "$now" "$label" "$cmd" "$rc" "$approver" "$(cat /run/msp/recording 2>/dev/null || echo none)" > "$r"
chmod 640 "$r"; chgrp msp-agent "$r" 2>/dev/null
exit "$rc"
