#!/bin/sh
# msp-run-check NAME: lock, run check-NAME.sh, write state atomically, log changes, notify.
# Exit code is the check's (0 ok, 1 warn, 2 crit); the unit treats those as success. 3+ = the checker broke.
set -u
name=$1
. /etc/msp/msp.conf
lib=/usr/local/lib/msp; state=/var/lib/msp/state; log=/var/log/msp
mkdir -p "$state" "$log" /run/lock
exec 9>"/run/lock/msp-$name.lock"
flock -n 9 || { echo "msp-run-check: $name already running" >&2; exit 3; }
[ -x "$lib/checks/check-$name.sh" ] || { echo "msp-run-check: no such check $name" >&2; exit 3; }

out=$(mktemp) || exit 3
"$lib/checks/check-$name.sh" > "$out" 2>&1; rc=$?
msg=$(head -n 1 "$out"); rm -f "$out"
if [ "$rc" -ge 3 ]; then echo "msp-run-check: $name broke: rc=$rc $msg" >&2; exit "$rc"; fi
now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# state, written whole then moved into place
prev="$state/$name.state"; new=$(mktemp -p "$state") || exit 3
printf 'rc=%s\nmsg=%s\nat=%s\n' "$rc" "$msg" "$now" > "$new"
if [ -f "$prev" ] && [ "$(sed -n 's/^rc=//p' "$prev")" = "$rc" ] && [ "$(sed -n 's/^msg=//p' "$prev")" = "$msg" ]
then changed=0; else changed=1; fi
mv -f "$new" "$prev"; chmod 644 "$prev"

# consecutive crit runs before paging
sf="$state/$name.streak"; s=$(cat "$sf" 2>/dev/null || echo 0)
if [ "$rc" -ge 2 ]; then s=$((s+1)); else s=0; fi; echo "$s" > "$sf"

if [ "$changed" = 1 ]; then
  logger -t msp-check "$name changed: rc=$rc $msg"
  printf '%s %s rc=%s %s\n' "$now" "$name" "$rc" "$msg" >> "$log/changes.log"
fi

# Notify through msp-notify, which fans the event out to every configured backend. Healthchecks semantics
# are unchanged: a plain ping carries the message until a crit repeats MSP_CONSECUTIVE times, then /fail
# pages. A state change also rides an SNMP trap to the site's own NMS when one is configured.
mode=alive
[ "$rc" -ge 2 ] && [ "$s" -ge "${MSP_CONSECUTIVE:-2}" ] && mode=fail
/usr/local/bin/msp-notify "$name" "$rc" "$msg" "$mode" "$changed"
# the checker ID otherwise only ever receives /fail from msp-alert and would read as never pinged:
# the heartbeat run keeps it alive, so only a real checker crash flips it.
[ "$name" = heartbeat ] && /usr/local/bin/msp-notify _checker 0 "checker alive" alive 0
exit "$rc"