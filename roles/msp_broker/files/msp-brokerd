#!/usr/bin/env python3
import os
import sys

sys.path.insert(0, os.environ.get("MSP_BROKER_LIB", "/usr/local/lib/msp-broker"))

from broker.daemon import build_service
from broker.server import main


def run():
    service = build_service()
    if "--check" in sys.argv[1:]:
        print("ok: %s / %s, %d adapters" % (
            service.client["client_id"], service.client["site_id"], len(service.adapters)))
        return
    main(service, service.paths, service.policy)


if __name__ == "__main__":
    run()
