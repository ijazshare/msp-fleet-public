#!/usr/bin/env python3
import os
import sys

sys.path.insert(0, os.environ.get("MSP_BROKER_LIB", "/usr/local/lib/msp-broker"))

from broker.adapters import Refused
from broker.cli import dump, request
from broker.config import Paths

USAGE = "usage: msp-read inventory | target REF | <adapter>.<verb> [ARGS...]"


def main(argv):
    if not argv:
        print(USAGE, file=sys.stderr)
        return 2
    try:
        result = request(Paths().socket, "read", {"verb": argv[0], "args": argv[1:]})
    except Refused as exc:
        print("refused: %s" % exc, file=sys.stderr)
        return 2
    dump(result)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
