[Unit]
Description=msp broker: approval-gated privileged execution
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/local/bin/msp-brokerd --check
ExecStart=/usr/local/bin/msp-brokerd
Restart=on-failure
UMask=0077
RuntimeDirectory=msp
RuntimeDirectoryMode=0770
NoNewPrivileges=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/msp-broker /var/log/msp-broker /run/msp

[Install]
WantedBy=multi-user.target
