# {{ ansible_managed }}
# Egress for {{ msp_llm_user }}: DNS, the public internet, and SSH to this site's gated hypervisors. Every other
# private, shared, link-local or multicast IPv4 address and all of IPv6 is refused. Root and every other user are
# untouched. Loaded atomically (the table is replaced, never left half-built) by msp-llm-firewall.service.
table inet msp_llm
delete table inet msp_llm
table inet msp_llm {
	set hypervisors {
		type ipv4_addr
{% if msp_llm_hypervisor_addrs %}
		elements = { {{ msp_llm_hypervisor_addrs | join(', ') }} }
{% endif %}
	}
	set allow {
		type ipv4_addr
		flags interval
{% if msp_llm_allow %}
		elements = { {{ msp_llm_allow | join(', ') }} }
{% endif %}
	}
	chain out {
		type filter hook output priority filter; policy accept;
		meta skuid != "{{ msp_llm_user }}" accept
		oifname "lo" accept
		# ponytail: IPv6 off for llm (clients fall back to IPv4 at once); a global v6 address on a hypervisor is unreachable this way
		meta nfproto ipv6 counter reject with icmpx admin-prohibited
		# a gated hypervisor gets SSH only, even on a public address (its :8006 and anything else are refused)
		ip daddr @hypervisors tcp dport 22 accept
		ip daddr @hypervisors counter reject with icmpx admin-prohibited
		# ponytail: DNS to any other address, since the resolver may be a client DC; port 53 is the only LAN port open to llm
		udp dport 53 accept
		tcp dport 53 accept
		ip daddr @allow accept
		ip daddr { 0.0.0.0/8, 192.0.2.1/8, 100.64.0.0/10, 169.254.0.0/16, 192.0.2.1/12, 192.0.0.0/24, 192.0.2.1/16, 198.18.0.0/15, 224.0.0.0/3 } counter reject with icmpx admin-prohibited
	}
}
