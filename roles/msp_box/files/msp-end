#!/bin/sh
# msp-end [--check|--force]: end-of-session etiquette, verified, then the tmux session ends.
# Done means: a session note written in the last 12 hours, nothing uncommitted, nothing unpushed.
repo=$(cat "$HOME/.msp-repo" 2>/dev/null) || { echo "no repo configured"; exit 1; }
cd "$repo" || exit 1
ok=1
git fetch -q origin 2>/dev/null || true
if [ -n "$(git status --porcelain)" ]; then echo "NOT DONE: uncommitted changes:"; git status --short | head -n 10; ok=0; fi
if [ -n "$(git log --oneline '@{u}..HEAD' 2>/dev/null)" ]; then echo "NOT DONE: commits not pushed:"; git log --oneline '@{u}..HEAD'; ok=0; fi
note=$(find sessions -name '*.md' -mmin -720 2>/dev/null | sort | tail -n 1)
[ -n "$note" ] || { echo "NOT DONE: no session note in the last 12 hours (tell the agent: end session)"; ok=0; }
if [ $ok = 1 ]; then
  echo "session complete: $note, pushed at $(git rev-parse --short HEAD)"
  [ "${1:-}" = --check ] || tmux kill-session -t msp 2>/dev/null
  exit 0
fi
echo "fix the above and run msp-end again, or msp-end --force to end anyway"
[ "${1:-}" = --force ] && tmux kill-session -t msp 2>/dev/null
exit 1
