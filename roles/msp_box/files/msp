#!/bin/sh
# msp HOST VERB [ARGS]: the LLM's only path to a host. Reads are free; "stage LABEL -- cmd" goes to the gate.
#   msp lab qm-list            msp lab journal pve-cluster 50            msp lab stage SAFE -- qm start 999
[ $# -ge 2 ] || { echo "usage: msp HOST VERB [ARGS]   hosts: $(cut -d= -f1 /etc/msp/hosts.conf | tr '\n' ' ')"; exit 2; }
h=$1; shift
case $h in ''|*[!A-Za-z0-9_-]*) echo "host name: letters, digits, _ and - only"; exit 2;; esac
addr=$(awk -F= -v h="$h" '$1==h {print $2; exit}' /etc/msp/hosts.conf)
case $addr in ''|*[!A-Za-z0-9.:_-]*) echo "unknown host $h"; exit 2;; esac
exec ssh -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=10 -i "$HOME/.ssh/msp_interactive" "msp-agent@$addr" "$@"
