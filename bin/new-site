#!/bin/sh
# bin/new-site SITE BOX_ADDR PVE_ADDR [LAB_ADDR]: scaffold a new client site.
# Writes inventory/<site>.yml, group_vars/<site>.yml and host_vars/<site>-*.yml stubs. Never overwrites.
# The inventory is the inventory/ DIRECTORY: each site owns one file, so sites never edit each other.
set -eu
site=${1:?usage: bin/new-site SITE BOX_ADDR PVE_ADDR [LAB_ADDR]}; box=${2:?usage: bin/new-site SITE BOX_ADDR PVE_ADDR [LAB_ADDR]}
pve=${3:?usage: bin/new-site SITE BOX_ADDR PVE_ADDR [LAB_ADDR]}; lab=${4:-}
case $site in *[!a-z0-9]*) echo "site: lowercase letters and digits only"; exit 1;; esac
[ "$site" = "${site#-}" ] || { echo "site: must not start with -"; exit 1; }
cd "$(dirname "$0")/.."
for f in "inventory/$site.yml" "group_vars/$site.yml"; do
  [ -e "$f" ] && { echo "refusing: $f already exists"; exit 1; }
done
mkdir -p inventory group_vars host_vars
{
  printf '# %s site. One file per site; generated by bin/new-site.\n' "$site"
  printf 'all:\n  children:\n    pve_hosts:\n      hosts:\n'
  printf '        %s-pve:\n          ansible_host: %s\n          ansible_user: root\n          msp_gate: true\n' "$site" "$pve"
  if [ -n "$lab" ]; then
    printf '        %s-lab:\n          ansible_host: %s\n          ansible_user: root\n          msp_lab: true\n          msp_root_key_only: false\n' "$site" "$lab"
  fi
  printf '    box:\n      vars:\n        msp_checks_extra: [guarantee, scratch]\n      hosts:\n'
  printf '        %s-box:\n          ansible_host: %s\n          ansible_user: root\n' "$site" "$box"
  printf '    %s:\n      hosts:\n        %s-pve:\n' "$site" "$site"
  [ -n "$lab" ] && printf '        %s-lab:\n' "$site"
  printf '        %s-box:\n      vars:\n        site: %s\n        pve_node: %s-pve\n        msp_box_host: %s-box\n' \
    "$site" "$site" "$site" "$site"
} > "inventory/$site.yml"
cp examples/group_vars-site.yml "group_vars/$site.yml"
for h in box pve; do
  cat > "host_vars/$site-$h.yml" <<EOF
# Healthchecks UUIDs for $site-$h (one check per subject; the check name is the message).
# Empty is valid: checks run and state is written, there is just no ping. Add UUIDs when the site's
# Healthchecks project exists, or set msp_hc_base to a self-hosted instance in group_vars/$site.yml.
msp_healthchecks: {}
EOF
done
if [ -n "$lab" ]; then
  cat > "host_vars/$site-lab.yml" <<EOF
# Healthchecks UUIDs for $site-lab (see host_vars/$site-pve.yml). Empty is valid.
msp_healthchecks: {}
EOF
fi
if [ -x .venv/bin/ansible-inventory ]; then
  if .venv/bin/ansible-inventory --graph "$site" >/dev/null 2>&1; then
    echo "inventory ok:"
    .venv/bin/ansible-inventory --graph "$site"
  else
    echo "WARNING: inventory did not load; check inventory/$site.yml by hand" >&2
  fi
fi
cat <<EOF

Written: inventory/$site.yml, group_vars/$site.yml, host_vars/$site-*.yml
Next:
  1. Fill in group_vars/$site.yml: msp_repo_url, msp_never_stage, msp_operator_pubkeys, msp_baseline.guests.exclude.
  2. Put ops's key on root of each host (Proxmox web shell on hypervisors; Debian install on the box).
  3. Deploy and prove:   ap playbooks/site.yml -l $site
  4. Add the deploy key the box prints to the client repo, then run step 3 again.
EOF