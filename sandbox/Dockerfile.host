# Throwaway stand-in for a hypervisor: Debian 13 + systemd + sshd. No PVE; read verbs answer "not available".
FROM debian:13
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus python3 curl ca-certificates procps less git openssh-server sudo bsdutils util-linux \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && systemctl mask getty@tty1.service systemd-logind.service console-getty.service
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
